# Copy to `.env` for local development (never commit `.env`).
# Full backend setup: docs/BACKEND_SETUP.md

# Supabase cloud sync + email auth (https://supabase.com/dashboard)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Required for multi-crew productions + Invite Codes. Run migrations 001–009 in SQL Editor.
VITE_FABRIC_FLO_BACKEND=normalized

# Public HTTPS origin (App Store privacy URL, password reset, Supabase redirects).
# Netlify: https://your-site-name.netlify.app  or custom domain — no trailing slash
VITE_PUBLIC_APP_URL=

# Support and privacy contacts (shown in-app and store listings).
VITE_SUPPORT_EMAIL=support@fabricflo.app
VITE_PRIVACY_EMAIL=privacy@fabricflo.app

# Optional: Supabase Edge Function name for full auth user deletion after RPC wipe.
# Deploy supabase/functions/delete-account — set to "0" to skip Edge Function.
# VITE_ACCOUNT_DELETE_EDGE=1

# Handwritten label OCR (operator): deploy supabase/functions/label-ocr and set Supabase secret
# GOOGLE_VISION_API_KEY — see docs/LABEL_OCR_SETUP.md (not a VITE_ variable).
