{
  "name": "fabric-flo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "cap:sync": "npm run build && npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android",
    "cap:add": "npx cap add ios && npx cap add android && node scripts/patch-capacitor-native.mjs",
    "cap:sync:full": "npm run build && npx cap sync && node scripts/patch-capacitor-native.mjs",
    "legal:pdf": "node scripts/generate-legal-pdf.mjs",
    "store:pdf": "node scripts/generate-store-checklist-pdf.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "fabric-catalog:import": "node scripts/import-fabric-type-catalog.mjs",
    "supabase:bundle": "node scripts/bundle-supabase-migrations.mjs",
    "netlify:deploy": "npm run build && npx netlify-cli deploy --prod --dir=dist",
    "knowledge:export": "node scripts/export-claude-knowledge-pack.mjs",
    "build:native": "bash scripts/mac-build-native.sh"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/network": "^6.0.3",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "@supabase/supabase-js": "^2.105.4",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tesseract.js": "^5.1.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.3",
    "md-to-pdf": "^5.2.4",
    "xlsx": "^0.18.5",
    "typescript": "~5.6.2",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5"
  }
}
